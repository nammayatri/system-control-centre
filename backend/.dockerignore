# Build artifacts
dist-newstyle
.stack-work

# Local state
.local
.env
.env.local
.envrc

# Editor / VCS
.git
.github
.vscode
.idea
*.swp
*.swo

# Nix
result
result-*
flake.lock

# Logs
*.log

# Dhall configs are NOT baked into the runtime image (matches NammaYatri's
# pattern). Production mounts a real dhall file at runtime via k8s Secret.
# Exclude the dhall files so a developer's local secrets.dhall can never leak
# into the image — but KEEP config-review-rules/, the non-secret static AI
# review rules the Dockerfile bakes in (COPY .../config-review-rules).
dhall-configs/*
!dhall-configs/config-review-rules
!dhall-configs/config-review-rules/**
