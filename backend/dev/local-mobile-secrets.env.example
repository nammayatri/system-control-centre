# Local-dev secrets + settings for the Mobile Releases feature.
#
# Copy to `local-mobile-secrets.env` (same directory) and fill in. It is
# git-ignored. The dev shell (flake.nix backend process) SOURCES this file, so
# the SC_* secrets become environment variables read by Core.Secrets
# (loadGhCreds / loadPlayCreds / loadAscCreds) — secrets are NOT stored in the DB.
# The non-secret settings at the bottom are applied to the local DB by
# backend/scripts/setup-mobile-local.sh.
#
# Multi-line blobs (private keys, JSON) are base64-encoded to a single line:
#   macOS:  base64 -i path/to/file | tr -d '\n'
#   linux:  base64 -w0 path/to/file

# ═══ SECRETS (read from env — never the DB) ═══════════════════════════════════

# ── GitHub App ──
# Create a GitHub App (actions:write, contents:read, metadata:read), install it
# on the dispatch repo (install URL ends in the installation id), generate a key.
SC_GITHUB_APP_ID=
SC_GITHUB_APP_INSTALLATION_ID=
# base64 of the App's .pem private key:  base64 -i app.pem | tr -d '\n'
SC_GITHUB_APP_PRIVATE_KEY_B64=

# ── Play Console service account ──
# GCP → IAM → Service Accounts → Add Key → JSON. Invite the SA email in Play
# Console with at least "View app information".
# base64 of the JSON key:  base64 -i service-account.json | tr -d '\n'
SC_PLAY_SA_JSON_B64=

# ── App Store Connect (iOS — leave blank to skip) ──
# The DEFAULT account (most apps: NammaYatri, ManaYatri, Yatri, OdishaYatri,
# KeralaSavaari, BharatTaxi, Lynx, Bridge).
SC_ASC_ISSUER_ID=
SC_ASC_KEY_ID=
# base64 of the .p8 key file:  base64 -i AuthKey_XXXX.p8 | tr -d '\n'
SC_ASC_PRIVATE_KEY_P8_B64=

# ── App Store Connect — additional Apple accounts (multi-account) ──
# Some apps live in a different Apple team than the default key. They carry an
# `app_catalog.store_account` tag (migration 0033) and SCC reads each with the
# matching SC_ASC_*_<ACCOUNT> key (account name uppercased, non-alphanumerics → _).
# A tagged app with no key configured is logged + skipped — NO fallback to the
# default key (that would 403 the wrong team). Issuer/key ids come from
# ny-react-native .github/workflows/fastlane.yaml (key_id_map / issuer_map); the
# .p8 from that app's GitHub secret. Leave blank to skip.

# store_account = 'cumta'  (Cumta)
SC_ASC_ISSUER_ID_CUMTA=
SC_ASC_KEY_ID_CUMTA=
SC_ASC_PRIVATE_KEY_P8_B64_CUMTA=

# store_account = 'yatrisathi'  (YatriSathi + YatriSathiDriver)
SC_ASC_ISSUER_ID_YATRISATHI=
SC_ASC_KEY_ID_YATRISATHI=
SC_ASC_PRIVATE_KEY_P8_B64_YATRISATHI=

# ── Airborne OTA (docs/AIRBORNE_OTA_INTEGRATION.md §5.1) ──
# Service-account PAT for the airborne proxy (Products.AirborneOta.Client).
# client_id/client_secret come from the one-time PAT enrolment (POST /api/token
# as the bot user). The secret is base64-encoded like every *_B64 var above:
#   printf '%s' '<client_secret>' | base64 | tr -d '\n'
# Leave blank to run without upstream calls (UI works; proxied routes return
# "credentials not configured"; keepalive disables itself with one warning).
SC_AIRBORNE_PAT_CLIENT_ID=
SC_AIRBORNE_PAT_CLIENT_SECRET_B64=

# Optional override; defaults to the hosted instance.
# SC_AIRBORNE_URL=https://airborne.juspay.in

# ── Chime / appmonitor (OTA fleet push campaigns + adoption) ──
# The Chime service behind the fleet-campaign card and adoption tiles
# (Products.AirborneOta.Chime; docs/superpowers/plans/2026-08-05-chime-fleet-campaign-ui.md).
# Plain strings, NOT base64. Leave blank to run without campaigns — the UI
# shows the calm "campaign key not configured" card; everything else works.
# Production: https://appmonitor.moving.tech · Master: https://appmonitor.integ.moving.tech
SC_CHIME_URL=
SC_CHIME_API_KEY=

# ═══ NON-SECRET local setup (applied to the DB by setup-mobile-local.sh) ══════

# Enable the dispatch endpoint (workflow_dispatch). "false" keeps mobile no-op.
MOBILE_DISPATCH_ENABLED=true

# Comma-separated app names to enable in app_catalog (from the seed: Cumta,
# NammaYatri, ManaYatri, Yatri, OdishaYatri, YatriSathi, KeralaSavaari, Bridge,
# BharatTaxi, Lynx). "all" enables every app; "none"/blank skips.
ENABLE_APPS=NammaYatri

# Optional: redirect ALL enabled apps' github_repo + workflow_path to a sandbox
# for safe end-to-end testing. Leave blank to keep the seeded production values.
SANDBOX_GITHUB_REPO=
SANDBOX_WORKFLOW_PATH=
